  "howto_account": {
    "en": "<b>Create an account</b>, here or in the app. It is free and takes a moment.",
    "de": "<b>Konto erstellen</b>, hier oder in der App. Kostenlos und in einem Moment erledigt.",
    "es": "<b>Crea una cuenta</b>, aquí o en la app. Es gratis y se hace en un momento.",
    "fr": "<b>Créez un compte</b>, ici ou dans l'application. C'est gratuit et rapide.",
    "pt": "<b>Crie uma conta</b>, aqui ou no aplicativo. É grátis e leva um instante.",
    "tr": "<b>Hesap oluştur</b>, burada ya da uygulamada. Ücretsiz ve bir anda biter."
  },
  "howto_android": {
    "en": "<b>Android:</b> install the app. In TikTok tap <b>Share</b> and then <b>Syntracks</b>. The server identifies the song by itself, slowed versions included.",
    "de": "<b>Android:</b> App installieren. In TikTok beim Video auf <b>Teilen</b> und dann <b>Syntracks</b> tippen. Der Server erkennt den Song von selbst, auch Slowed-Versionen.",
    "es": "<b>Android:</b> instala la app. En TikTok pulsa <b>Compartir</b> y luego <b>Syntracks</b>. El servidor identifica la canción solo, también las versiones ralentizadas.",
    "fr": "<b>Android :</b> installez l'application. Dans TikTok, touchez <b>Partager</b> puis <b>Syntracks</b>. Le serveur identifie le titre tout seul, versions ralenties comprises.",
    "pt": "<b>Android:</b> instale o aplicativo. No TikTok toque em <b>Compartilhar</b> e depois em <b>Syntracks</b>. O servidor identifica a música sozinho, inclusive versões lentas.",
    "tr": "<b>Android:</b> uygulamayı kur. TikTok'ta <b>Paylaş</b> ve ardından <b>Syntracks</b>'e dokun. Sunucu şarkıyı kendisi tanır, yavaşlatılmış sürümler dahil."
  },
  "howto_browser": {
    "en": "<b>Browser:</b> install the extension from the Chrome Web Store. After that every TikTok video gets its own save button.",
    "de": "<b>Browser:</b> Erweiterung aus dem Chrome Web Store installieren. Danach hängt unter jedem TikTok-Video ein eigener Speichern-Button.",
    "es": "<b>Navegador:</b> instala la extensión desde Chrome Web Store. Después cada vídeo de TikTok tiene su propio botón de guardar.",
    "fr": "<b>Navigateur :</b> installez l'extension depuis le Chrome Web Store. Ensuite, chaque vidéo TikTok a son propre bouton d'enregistrement.",
    "pt": "<b>Navegador:</b> instale a extensão na Chrome Web Store. Depois cada vídeo do TikTok ganha seu próprio botão de salvar.",
    "tr": "<b>Tarayıcı:</b> uzantıyı Chrome Web Store'dan kur. Sonrasında her TikTok videosunun kendi kaydetme düğmesi olur."
  },
  "howto_iphone": {
    "en": "<b>iPhone:</b> follow the shortcut guide. Afterwards Syntracks sits in the TikTok share sheet.",
    "de": "<b>iPhone:</b> der Kurzbefehl-Anleitung folgen. Danach steht Syntracks im Teilen-Menü von TikTok.",
    "es": "<b>iPhone:</b> sigue la guía del atajo. Después Syntracks aparece en el menú de compartir de TikTok.",
    "fr": "<b>iPhone :</b> suivez le guide du raccourci. Ensuite, Syntracks apparaît dans le menu de partage de TikTok.",
    "pt": "<b>iPhone:</b> siga o guia do atalho. Depois o Syntracks aparece no menu de compartilhamento do TikTok.",
    "tr": "<b>iPhone:</b> kısayol rehberini izle. Sonrasında Syntracks TikTok'un paylaşım menüsünde yer alır."
  },
